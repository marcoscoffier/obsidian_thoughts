# Ignore everything at the root by default...
/*
!/.gitignore

# ...except these vaults
!/personal_history/
!/thoughts/
!/papa_slides/

# Images / binaries (not tracked yet)
*.jpg
*.jpeg
*.JPG
*.png
*.PNG
*.gif
*.webp
*.heic
*.pdf

# Symlinks to image folders in ~/Pictures (machine-specific)
/papa_slides/media/

# Obsidian per-device UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store

# Per-device Obsidian state inside each vault (the pattern above only matched the root)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Journal-scan staging folders (reviewed before anything moves into the vault)
_import_*/
